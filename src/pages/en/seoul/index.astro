---
// English Seoul hub (old URL /en/seoul/): map split by the Han River, 25 districts with neighborhood counts and lessons
import Base from '../../../layouts/Base.astro';
import RegionMap from '../../../components/RegionMap.astro';
import { href } from '../../../lib/paths';
import { region, svgOf, enNameOf, SEOUL_NORTH } from '../../../lib/geo';
import { DATA_VER } from '../../../consts';

const r = region('seoul');
const svg = svgOf('seoul');
const dongs = (id: string) => svg.items.find((it) => it.id === id)!.dongs.length;
const total = r.items.reduce((s, it) => s + dongs(it.id), 0);
const tone = Object.fromEntries(r.items.map((it) => [it.id, SEOUL_NORTH.has(it.id) ? 'a' : 'b'])) as Record<string, 'a' | 'b'>;
const lessonOf = (id: string) => r.lessons.find((l) => l.items.includes(id))!;
const rows = [...r.items].sort((a, b) => Number(SEOUL_NORTH.has(b.id)) - Number(SEOUL_NORTH.has(a.id)) || enNameOf(a.id).localeCompare(enNameOf(b.id)));
---
<Base lang="en" title="Seoul's 25 districts on the map – Fill the Map" description={`Seoul has 25 autonomous districts: 14 north of the Han River and 11 south of it, with ${total} administrative neighborhoods. See them on a map and learn them lesson by lesson.`} alternate={{ ko: '/seoul/', en: '/en/seoul/' }}>
  <div class="wrap page">
    <nav class="meta" aria-label="Breadcrumb"><a href={href('/en/')}>Home</a> › Seoul</nav>
    <div class="stack">
      <h1>Seoul's 25 districts</h1>
      <p class="lead">Seoul is divided into 25 autonomous districts (gu). The Han River runs through the city: 14 districts lie on its north side and 11 on its south side. Together they have {total} administrative neighborhoods (haengjeong-dong) in the October 1, 2026 boundary data.</p>
    </div>
    <a class="btn" href={href('/en/#/kr/seoul/sgg/p1')}>Start with Seoul lesson 1</a>
    <figure class="stack fig">
      <RegionMap region="seoul" tone={tone} label="Map of Seoul's 25 districts: the 14 north of the Han River are shaded" />
      <figcaption class="meta">Shaded: north of the Han River (14). Light: south of it (11).</figcaption>
    </figure>
    <section class="stack">
      <h2>How Fill the Map teaches Seoul</h2>
      <p>The 25 districts are grouped into five lessons of four to six places. You start downtown, move to the southern half of the city, then finish in the northeast. After the five lessons there is a full practice with all 25 mixed together and a timed test.</p>
      <div class="tbl"><table>
        <thead><tr><th scope="col">Lesson</th><th scope="col">Districts</th></tr></thead>
        <tbody>{r.lessons.map((l) => <tr><td><a href={href(`/en/#/kr/seoul/sgg/p${l.no}`)}>{l.no}. {l.en}</a></td><td>{l.items.map(enNameOf).join(', ')}</td></tr>)}</tbody>
      </table></div>
    </section>
    <section class="stack">
      <h2>All 25 districts</h2>
      <div class="tbl"><table>
        <thead><tr><th scope="col">District</th><th scope="col">Han River</th><th scope="col">Neighborhoods</th><th scope="col">Lesson</th></tr></thead>
        <tbody>{rows.map((it) => (
          <tr><td><a href={href(`/en/seoul/${it.slug}/`)}>{enNameOf(it.id)}</a></td><td>{SEOUL_NORTH.has(it.id) ? 'north' : 'south'}</td><td class="num">{dongs(it.id)}</td><td>{lessonOf(it.id).no}</td></tr>
        ))}</tbody>
      </table></div>
    </section>
    <p class="meta">Boundaries: Statistics Korea SGIS (KOGL Type 1) · vuski/admdongkor (CC BY 4.0), October 1, 2026 edition · data {DATA_VER}.</p>
  </div>
</Base>

<style>
  .fig { margin: 0; }
  .tbl { overflow-x: auto; }
  .tbl table { border-collapse: collapse; width: 100%; font-size: 15px; line-height: 22px; }
  .tbl th, .tbl td { border-bottom: 1px solid var(--line); padding: 8px 6px; text-align: left; vertical-align: top; }
  .tbl th { font-family: var(--font-head); color: var(--ink-2); font-size: 14px; }
  .tbl td:first-child { white-space: nowrap; }
</style>
