---
// English home = the same study app with English text (design 7.2). Place one-liners and guides stay Korean-only.
// Without JS the fallback below links to the static Seoul pages
import Base from '../../layouts/Base.astro';
import '../../app/map/map.css';
import '../../app/ui/app.css';
import { href } from '../../lib/paths';
import { TAGLINE_EN, DATA_VER } from '../../consts';
---
<Base lang="en" title="Fill the Map – Learn Korea's administrative regions on a blank map" description="A blank-map quiz for the districts of Seoul, Incheon and Gyeonggi. Meet four to six places at a time, find them with the names hidden, and review them the next day." alternate={{ ko: '/', en: '/en/' }}>
  <div id="app" data-base={import.meta.env.BASE_URL} data-ver={DATA_VER}>
    <script is:inline>
      // Returning visitors: hide the first-visit fallback before it flashes (progress is shared with the Korean app)
      try { if (localStorage.getItem('kgq_mastery_v1:p1')) document.documentElement.classList.add('kgq-ret'); } catch (e) {}
    </script>
    <div class="page app-fallback">
      <h1 class="title-26">Fill the Map</h1>
      <p class="sub">{TAGLINE_EN}</p>
      <section class="card" aria-labelledby="start">
        <h2 class="title-22" id="start">Seoul lesson 1 · Downtown and northwest, 6 districts</h2>
        <p class="t15">Meet the places one by one on the map, then find them with the names hidden</p>
        <a class="btn" href={href('/en/seoul/')}>Seoul's 25 districts</a>
        <noscript><p class="t13">The study screens need JavaScript</p></noscript>
      </section>
    </div>
  </div>
  <style is:global>
    .kgq-ret .app-fallback { visibility: hidden; }
    .app-fallback { min-height: 60vh; }
  </style>
  <script>
    import '../../app/main.ts';
  </script>
</Base>
