---
// English Incheon hub (Korean twin: /incheon/): map of 2 counties and 9 districts, tables, and the July 2026 reorganization (old Jung-gu, Dong-gu, Seo-gu -> new districts, built from data).
// Same layout as the Korean hub: text | map in two columns on wide screens, one column on narrow screens (tokens.css .d-top.hub; the key has three lines, so --hub-key makes room)
import Base from '../../../layouts/Base.astro';
import RegionMap from '../../../components/RegionMap.astro';
import { href } from '../../../lib/paths';
import { region, svgOf, countKinds, enNameOf, enDongs } from '../../../lib/geo';
import reform from '../../../data/incheon-reform.json';
import { guideIfEn } from '../../../guides-en/registry';
import { regionIntroOf } from '../../../data/region-intro';

const r = region('incheon');
const svg = svgOf('incheon');
const dongsOf = (id: string) => svg.items.find((it) => it.id === id)!.dongs;
const all = r.items.flatMap((it) => dongsOf(it.id));
const k = countKinds(all);
const NEW = new Set(['제물포구', '영종구', '서해구', '검단구']);
const lessonOf = (id: string) => r.lessons.find((l) => l.items.includes(id))!;
const ORDER = ['강화군', '옹진군', '검단구', '서해구', '계양구', '부평구', '제물포구', '영종구', '미추홀구', '연수구', '남동구'];
const rows = ORDER.map((n) => r.items.find((it) => it.ko === n)!);
const idOfKo = (n: string) => r.items.find((it) => it.ko === n)!.id;
const OLD_EN: Record<string, string> = { '중구': 'Jung-gu', '동구': 'Dong-gu', '서구': 'Seo-gu' };
const DONG_EN = new Map(r.items.flatMap((it) => { const en = enDongs(it.id); return dongsOf(it.id).map((n, i) => [n, en[i]] as [string, string]); }));
const dongEn = (n: string) => DONG_EN.get(n) ?? n;
const oldEn = (n: string) => OLD_EN[n] ?? n;
const kindsEn = (dongs: string[]) => {
  const c = countKinds(dongs);
  return [c.읍 && `${c.읍} eup`, c.면 && `${c.면} myeon`, c.동 && `${c.동} dong`].filter(Boolean).join(', ');
};
// If the reorganization guide (G3) is in this build, the neighborhood list lives only there and this page shows counts only
const g3 = guideIfEn('incheon-reform-2026');
const SRC = {
  law: 'https://www.incheon.go.kr/IC01070105/3012613',
  rename: 'https://www.mois.go.kr/frt/bbs/type010/commonSelectBoardArticle.do?bbsId=BBSMSTR_000000000008&nttId=125833',
};
---
<Base lang="en" title="Incheon's 2 counties and 9 districts, and the July 2026 reorganization – Fill the Map" description={`See Incheon's 2 counties and 9 districts on a map. The July 1, 2026 reorganization created Jemulpo-gu, Yeongjong-gu and Geomdan-gu and renamed Seo-gu to Seohae-gu. A table shows which new district each old neighborhood went to.`} alternate={{ ko: '/incheon/', en: '/en/incheon/' }}>
  <div class="wrap page">
    <nav class="crumb" aria-label="Breadcrumb"><a href={href('/en/')}>Home</a> › Incheon</nav>
    <div class="d-top hub" style="--hub-key:48px">
      <div class="d-head">
        <h1 class="d-title">Incheon's 2 counties and 9 districts</h1>
      </div>
      <div class="d-body">
        <p class="lead">Incheon Metropolitan City is divided into 2 counties (gun), Ganghwa-gun and Ongjin-gun, and 9 districts (gu). In the reorganization of July 1, 2026, the old Jung-gu and Dong-gu became Jemulpo-gu and Yeongjong-gu, and the old Seo-gu became Seohae-gu and Geomdan-gu. There are {all.length} towns (eup), townships (myeon) and neighborhoods (dong) in all: {k.읍} eup, {k.면} myeon and {k.동} dong (October 1, 2026 boundary data).</p>
        <div class="d-acts"><a class="btn" href={href('/en/#/kr/incheon/sgg/p1')}>Start with Incheon lesson 1 <span aria-hidden="true">→</span></a></div>
      </div>
      <figure class="d-map">
        <RegionMap en region="incheon" labels alwaysLabel={rows.filter((it) => it.ko === '제물포구').map((it) => it.id)} highlight={rows.filter((it) => NEW.has(it.ko)).map((it) => it.id)} label="Map of Incheon's 2 counties and 9 districts: the 4 districts created or renamed in July 2026 are shaded yellow" />
        <figcaption class="d-key"><span class="note"><i class="sw s-hl"></i>Yellow: districts created or renamed in the July 2026 reorganization. Far islands of Ongjin-gun, such as Baengnyeongdo, Daecheongdo and Yeonpyeongdo, are outside the map.</span></figcaption>
      </figure>
    </div>

    <section class="d-sec">
      <h2>The July 2026 reorganization: what changed</h2>
      <ul>
        <li>Under the Act on the Establishment of Jemulpo-gu, Yeongjong-gu and Geomdan-gu of Incheon Metropolitan City, etc., the old Jung-gu and Dong-gu were merged and adjusted into Jemulpo-gu and Yeongjong-gu, and Seo-gu was split into Seo-gu and Geomdan-gu, from July 1, 2026 (<a href={SRC.law}>Incheon City press release</a>).</li>
        <li>On the same day, Seo-gu changed its name to Seohae-gu. The Bill on Changing the Name of Seo-gu, Incheon Metropolitan City was passed by the National Assembly in May 2026 (<a href={SRC.rename}>Ministry of the Interior and Safety press release, May 7, 2026</a>).</li>
        <li>So Incheon went from 2 counties and 8 districts to 2 counties and 9 districts. The Yeongjong-do and Yongyu-do area is Yeongjong-gu. The inland part of the old Jung-gu and the old Dong-gu make up Jemulpo-gu.</li>
      </ul>
      <p>The table below matches the neighborhood (haengjeong-dong) boundaries before the change (April 1, 2026) with those after it (October 1, 2026), by neighborhood name.</p>
      {g3 ? (
        <>
          <div class="tbl"><table>
            <thead><tr><th scope="col">New district</th><th scope="col">Neighborhoods from the old districts</th></tr></thead>
            <tbody>{reform.reform.map((row) => <tr><td>{enNameOf(idOfKo(row.new))}</td><td>{Object.entries(row.from).map(([old, list]) => `${(list as string[]).length} from the old ${oldEn(old)}`).join(' · ')}</td></tr>)}</tbody>
          </table></div>
          <p>The list of neighborhood names, maps from before and after the change, and the laws and dates are in <a href={href(`/en/guide/${g3.slug}/`)}>{g3.title}</a>.</p>
        </>
      ) : (
        <div class="tbl"><table>
          <thead><tr><th scope="col">New district</th><th scope="col">Neighborhoods from the old districts</th></tr></thead>
          <tbody>{reform.reform.map((row) => (
            <tr><td>{enNameOf(idOfKo(row.new))}<br /><span class="meta">{Object.values(row.from).flat().length}</span></td>
              <td>{Object.entries(row.from).map(([old, list]) => <p class="from"><b>Old {oldEn(old)}</b> {(list as string[]).length}: {(list as string[]).map(dongEn).join(' · ')}</p>)}</td></tr>
          ))}</tbody>
        </table></div>
      )}
    </section>

    <section class="d-sec">
      <h2>How Fill the Map teaches Incheon</h2>
      <p>The 11 places are split into three lessons: 4 in the north of the mainland, 4 in the south of the mainland, and 3 on the islands and the sea. After the lessons there is a full practice with all 11 mixed together and a timed test. In those, the map is split into two screens, the mainland and the islands.</p>
      <div class="tbl"><table>
        <thead><tr><th scope="col">Lesson</th><th scope="col">Counties and districts</th></tr></thead>
        <tbody>{r.lessons.map((l) => <tr><td><a href={href(`/en/#/kr/incheon/sgg/p${l.no}`)}>{l.no}. {l.en}</a></td><td>{l.items.map(enNameOf).join(', ')}</td></tr>)}</tbody>
      </table></div>
    </section>

    <section class="d-sec">
      <h2>All 11 counties and districts</h2>
      <div class="tbl"><table>
        <thead><tr><th scope="col">County or district</th><th scope="col">Towns, townships and neighborhoods</th><th scope="col">Lesson</th></tr></thead>
        <tbody>{rows.map((it) => (
          <tr><td>{regionIntroOf(it.id) ? <a href={href(`/en/incheon/${it.slug}/`)}>{enNameOf(it.id)}</a> : enNameOf(it.id)}{NEW.has(it.ko) && <span class="doc-tag">2026.7</span>}</td><td>{kindsEn(dongsOf(it.id))}</td><td>{lessonOf(it.id).no}</td></tr>
        ))}</tbody>
      </table></div>
      <p>eup = town, myeon = township, dong = neighborhood.</p>
    </section>
  </div>
</Base>
