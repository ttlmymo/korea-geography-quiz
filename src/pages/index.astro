---
// 홈 = '오늘 공부' 앱 문서(설계서 4.3·7.3). 공부 화면은 이 문서 안의 해시 경로(#/kr/...)로 돈다.
// JS 가 없으면 아래 대체 글과 /seoul/ 허브 링크가 보인다(해시 주소는 JS 없이는 열리지 않으므로)
import Base from '../layouts/Base.astro';
import '../app/map/map.css';
import '../app/ui/app.css';
import { href } from '../lib/paths';
import { TAGLINE, DATA_VER } from '../consts';
---
<Base title="채움지도 – 백지도 퀴즈로 익히는 대한민국 행정구역" description="지도에서 직접 찾으며 서울·인천·경기의 시·군·구를 익히는 백지도 퀴즈. 4~6곳씩 만나고 찾고, 다음 날 다시 풀어 지도를 채워요." alternate={{ ko: '/', en: '/en/' }}>
  <div id="app" data-base={import.meta.env.BASE_URL} data-ver={DATA_VER}>
    <script is:inline>
      // 다시 온 사람에게 '처음' 화면이 잠깐 보였다가 바뀌지 않게, 기록이 있으면 대체 글을 미리 가린다(자리는 그대로).
      // kgq-js: JS 가 켜져 있으면 지도 자리를 미리 잡아 둔다(앱이 뜰 때 화면이 덜 튀게). JS 가 없으면 빈 지도 칸은 보이지 않는다
      document.documentElement.classList.add('kgq-js');
      try { if (localStorage.getItem('kgq_mastery_v1:p1')) document.documentElement.classList.add('kgq-ret'); } catch (e) {}
    </script>
    <!-- 대체 글: 새 홈(합본 디자인 3.2)의 '처음 온 사람' 틀과 같은 자리·글자 크기. h1 글은 검색 쪽 결정이라 '채움지도' 그대로 -->
    <div class="page home app-fallback">
      <div class="h-tabs" aria-hidden="true"><span class="h-tab"></span></div>
      <div class="h-main">
        <div class="h-head">
          <p class="h-label">{TAGLINE}</p>
          <h1 class="h-title">채움지도</h1>
        </div>
        <div class="h-names">
          <h2 class="h-places">서울 1과 · 도심과 서북 6개 구</h2>
          <p class="h-desc">지도에서 하나씩 만나고, 이름을 가린 채 찾아요</p>
          <noscript><p class="h-note">공부 화면은 자바스크립트를 켜야 열려요</p></noscript>
        </div>
        <div class="h-acts"><a class="btn h-go" href={href('/seoul/')}>서울 25개 구 알아보기 <span aria-hidden="true">→</span></a></div>
        <div class="h-mapcol" style="--ar:1.23" aria-hidden="true"><div class="h-cap wide-only"><span class="h-ct">서울특별시 · 25개 구</span></div><div class="map-box h-map"></div></div>
      </div>
    </div>
  </div>
  <script>
    import '../app/main.ts';
  </script>
</Base>
