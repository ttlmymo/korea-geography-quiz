---
// 홈 = '오늘 공부' 앱 문서(설계서 4.3·7.3). 공부 화면은 이 문서 안의 해시 경로(#/kr/...)로 돈다.
// JS 가 없으면 아래 대체 글과 /seoul/ 허브 링크가 보인다(해시 주소는 JS 없이는 열리지 않으므로)
import Base from '../layouts/Base.astro';
import '../app/map/map.css';
import '../app/ui/app.css';
import { href } from '../lib/paths';
import { TAGLINE, DATA_VER } from '../consts';
---
<Base title="채움지도 – 백지도 퀴즈로 익히는 대한민국 행정구역" description="지도에서 직접 찾으며 서울·인천·경기의 시·군·구를 익히는 백지도 퀴즈. 4~6곳씩 만나고 찾고, 다음 날 다시 풀어 지도를 채워요." alternate={{ ko: '/', en: '/en/' }}>
  <div id="app" data-base={import.meta.env.BASE_URL} data-ver={DATA_VER}>
    <script is:inline>
      // 다시 온 사람에게 '처음' 카드가 잠깐 보였다가 바뀌지 않게, 기록이 있으면 대체 글을 미리 가린다(자리는 그대로)
      try { if (localStorage.getItem('kgq_mastery_v1:p1')) document.documentElement.classList.add('kgq-ret'); } catch (e) {}
    </script>
    <div class="page app-fallback">
      <h1 class="title-26">채움지도</h1>
      <p class="sub">{TAGLINE}</p>
      <section class="card" aria-labelledby="start">
        <h2 class="title-22" id="start">서울 1과 · 도심과 서북 6개 구</h2>
        <p class="t15">지도에서 하나씩 만나고, 이름을 가린 채 찾아요</p>
        <a class="btn" href={href('/seoul/')}>서울 25개 구 알아보기</a>
        <noscript><p class="t13">공부 화면은 자바스크립트를 켜야 열려요</p></noscript>
      </section>
    </div>
  </div>
  <style is:global>
    .kgq-ret .app-fallback { visibility: hidden; }
    .app-fallback { min-height: 60vh; }
  </style>
  <script>
    import '../app/main.ts';
  </script>
</Base>
