---
// 학습 가이드 목록(/guide/). 검수한 글이 하나도 없으면 배포 빌드에서는 '준비 중' 쪽(noindex)으로 둔다.
// 모양(합본 D5): 둥근 카드 대신 홈 '과 목록'과 같은 선 목록(위 2px 먹 · 줄 사이 1px 약선 · 아래 1px 먹, 줄 전체가 링크)
import Base from '../../layouts/Base.astro';
import { href } from '../../lib/paths';
import { visibleGuides } from '../../guides/registry';

const list = visibleGuides();
const anyReviewed = list.some((g) => g.reviewed);
---
<Base title="학습 가이드 – 채움지도" description="행정구역을 지도로 외우는 방법과 2026년에 바뀐 행정구역을 공공 자료로 정리한 글 모음이에요." ads={anyReviewed} noindex={!anyReviewed}>
  <div class="wrap page">
    <nav class="crumb" aria-label="현재 위치"><a href={href('/')}>홈</a> › 학습 가이드</nav>
    <div class="d-head">
      <h1>학습 가이드</h1>
      <p class="lead">행정구역을 지도로 외우는 방법과, 지도 공부에 필요한 행정구역 지식을 공공 자료로 정리해요.</p>
    </div>
    <p class="intro">글마다 정부·지자체 발표, 공공 데이터, 연구 논문 같은 1차 자료를 출처로 달고 고친 날을 적어요. 글 속 숫자 가운데 구·동 수나 맞닿은 곳처럼 지도로 셀 수 있는 것은 채움지도가 쓰는 경계 데이터로 다시 셌어요. 운영자가 원문과 대조해 확인한 글만 올리고, 틀린 곳을 알려 주시면 <a href={href('/contact/')}>문의</a>로 받아 고쳐요.</p>
    {list.length ? (
      <ul class="glist">{list.map((g) => (
        <li><a href={href(`/guide/${g.slug}/`)}><b>{g.title}{!g.reviewed && <span class="doc-tag">검수 전</span>}</b><span class="gd">{g.description}</span><span class="ar" aria-hidden="true">→</span></a></li>
      ))}</ul>
    ) : <p class="intro">첫 글을 준비하고 있어요.</p>}
  </div>
</Base>

<style>
  .d-head { gap: var(--sp-3); }
  .d-head .lead { max-width: var(--content-w); }
  .intro { max-width: var(--content-w); font-size: var(--fs-18); line-height: 1.7; }
  .glist { list-style: none; margin: var(--sp-4) 0 0; padding: 0; border-top: 2px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .glist li + li { border-top: 1px solid var(--line); }
  .glist a {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "t ar" "d ar"; align-items: center; gap: 6px var(--sp-5);
    padding: 18px 0; color: var(--ink); text-decoration: none;
  }
  .glist b { grid-area: t; font-size: var(--fs-18); line-height: 1.45; font-weight: 700; }
  .glist .gd { grid-area: d; max-width: 44em; font-size: var(--fs-16); line-height: 1.6; color: var(--ink-2); }
  .glist .ar { grid-area: ar; font-size: var(--fs-18); }
  .glist a:hover b { text-decoration: underline; text-underline-offset: 4px; }
  .glist a:hover { background: var(--sunk); }
</style>
