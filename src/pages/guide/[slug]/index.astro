---
// 학습 가이드 글(/guide/{slug}/). 검수 전 글은 개발 서버에서만 만들어지고 '검수 전 초안' 띠와 noindex 가 붙는다(registry.ts).
// 모양(합본 D5): 글은 34em(18px) 읽기 폭, 표·지도·지도 쌍은 조금 넓게(760px). 요약은 선 구획, 해 보기는 윗선 2px + 먹색 단추(공용 .cta)
import Base from '../../../layouts/Base.astro';
import { href } from '../../../lib/paths';
import { visibleGuides, type Guide } from '../../../guides/registry';
import SeoulGu from '../../../guides/SeoulGu.astro';
import Recall from '../../../guides/Recall.astro';
import KrDivisions from '../../../guides/KrDivisions.astro';
import IncheonReform from '../../../guides/IncheonReform.astro';
import GuTypes from '../../../guides/GuTypes.astro';
import LegalDong from '../../../guides/LegalDong.astro';

const BODY: Record<string, unknown> = { 'seoul-25-gu': SeoulGu, 'recall-practice': Recall, 'korea-divisions-2026': KrDivisions, 'incheon-reform-2026': IncheonReform, 'autonomous-vs-general-gu': GuTypes, 'legal-vs-administrative-dong': LegalDong };

export function getStaticPaths() {
  return visibleGuides().map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: Guide };
const Body = BODY[g.slug] as typeof SeoulGu;
const [y, m, d] = g.updated.split('-').map(Number);
---
<Base title={`${g.title} – 채움지도`} description={g.description} ads={!!g.reviewed} noindex={!g.reviewed}>
  <div class="wrap page">
    <nav class="crumb" aria-label="현재 위치"><a href={href('/')}>홈</a> › <a href={href('/guide/')}>학습 가이드</a></nav>
    {!g.reviewed && (
      <div class="draft" role="note"><b>검수 전 초안</b> — 공개 전에 운영자가 1차 자료와 대조합니다. 확인할 것: {g.check.join(' / ')}</div>
    )}
    <article class="article">
      <h1>{g.title}</h1>
      <p class="meta">고친 날 {y}년 {m}월 {d}일 · 채움지도{g.reviewed ? ` · 검수 ${g.reviewed}` : ''}</p>
      <Body />
    </article>
  </div>
</Base>

<style>
  .draft { max-width: 760px; }
  /* 글 상자는 760px(표·지도), 그 안의 글 덩어리는 34em */
  .article { max-width: 760px; display: flex; flex-direction: column; gap: var(--sp-4); font-size: var(--fs-18); line-height: 1.75; }
  /* 글 덩어리는 글자 크기와 상관없이 같은 오른쪽 선(본문 18px 의 34em = 612px)에 맞춘다 */
  .article > :global(:is(h1, h2, h3, p, ul, ol, .summary, .cta)) { max-width: calc(34 * var(--fs-18)); }
  .article :global(h1) { font-size: var(--fs-title); line-height: 1.25; }
  .article :global(h2) { font-size: var(--fs-24); line-height: 1.4; margin-top: var(--sp-6); }
  .article :global(h3) { font-size: var(--fs-18); line-height: 1.45; margin-top: var(--sp-2); }
  .article :global(p) { margin: 0; }
  .article > :global(p.meta) { font-size: var(--fs-14); line-height: 1.6; }
  /* 이 글의 핵심: 면색 상자 대신 위 2px 먹 · 아래 1px 약선 */
  .article :global(.summary) { display: flex; flex-direction: column; gap: 6px; padding: 14px 0 16px; border-top: 2px solid var(--ink); border-bottom: 1px solid var(--line); font-size: var(--fs-16); line-height: 1.6; }
  .article :global(.summary b) { font-size: var(--fs-16); }
  /* 표 위아래 4px 는 공용 .tbl 의 안쪽 여백(초점 고리 자리)이 맡는다 */
  .article :global(.tbl) { margin-block: 0; }
  /* 숫자 칸(.num)만 오른쪽 맞춤: '옛 구'처럼 글인 칸은 왼쪽 그대로 */
  .article :global(table.nums :is(th, td).num) { text-align: right; }
  .article :global(ol), .article :global(ul) { margin: 0; padding-left: 1.3em; display: flex; flex-direction: column; gap: var(--sp-2); }
  .article :global(.cta) { margin-top: var(--sp-4); }
  .article :global(.sw) { vertical-align: -3px; margin-right: 7px; }
  .article :global(.src) { font-size: var(--fs-16); line-height: 1.6; color: var(--ink-2); }
</style>
