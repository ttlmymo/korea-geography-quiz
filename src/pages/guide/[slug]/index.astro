---
// 학습 가이드 글(/guide/{slug}/). 검수 전 글은 개발 서버에서만 만들어지고 '검수 전 초안' 띠와 noindex 가 붙는다(registry.ts)
import Base from '../../../layouts/Base.astro';
import { href } from '../../../lib/paths';
import { visibleGuides, type Guide } from '../../../guides/registry';
import SeoulGu from '../../../guides/SeoulGu.astro';
import Recall from '../../../guides/Recall.astro';
import KrDivisions from '../../../guides/KrDivisions.astro';
import IncheonReform from '../../../guides/IncheonReform.astro';
import GuTypes from '../../../guides/GuTypes.astro';
import LegalDong from '../../../guides/LegalDong.astro';

const BODY: Record<string, unknown> = { 'seoul-25-gu': SeoulGu, 'recall-practice': Recall, 'korea-divisions-2026': KrDivisions, 'incheon-reform-2026': IncheonReform, 'autonomous-vs-general-gu': GuTypes, 'legal-vs-administrative-dong': LegalDong };

export function getStaticPaths() {
  return visibleGuides().map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: Guide };
const Body = BODY[g.slug] as typeof SeoulGu;
const [y, m, d] = g.updated.split('-').map(Number);
---
<Base title={`${g.title} – 채움지도`} description={g.description} ads={!!g.reviewed} noindex={!g.reviewed}>
  <div class="wrap page">
    <nav class="meta" aria-label="현재 위치"><a href={href('/')}>홈</a> › <a href={href('/guide/')}>학습 가이드</a></nav>
    {!g.reviewed && (
      <div class="draft" role="note"><b>검수 전 초안</b> — 공개 전에 운영자가 1차 자료와 대조합니다. 확인할 것: {g.check.join(' / ')}</div>
    )}
    <article class="article">
      <h1>{g.title}</h1>
      <p class="meta">고친 날 {y}년 {m}월 {d}일 · 채움지도{g.reviewed ? ` · 검수 ${g.reviewed}` : ''}</p>
      <Body />
    </article>
  </div>
</Base>

<style>
  .draft { background: var(--due-soft); border: 1px solid var(--line); border-radius: var(--r-md); padding: var(--sp-3) var(--sp-4); font-size: 14px; line-height: 21px; color: var(--ink-2); }
  .article { max-width: var(--content-w); display: flex; flex-direction: column; gap: var(--sp-4); font-size: 17px; line-height: 28px; }
  .article :global(h1) { font-size: 26px; line-height: 34px; }
  .article :global(h2) { font-size: 22px; line-height: 30px; margin-top: var(--sp-2); }
  .article :global(p) { margin: 0; }
  .article :global(.summary) { background: var(--sunk); border-radius: var(--r-md); padding: 14px 16px; display: flex; flex-direction: column; gap: 6px; font-size: 16px; line-height: 24px; }
  .article :global(.tbl) { overflow-x: auto; }
  .article :global(table) { border-collapse: collapse; width: 100%; font-size: 15px; line-height: 22px; }
  .article :global(th), .article :global(td) { border-bottom: 1px solid var(--line); padding: 8px 6px; text-align: left; vertical-align: top; }
  .article :global(th) { font-family: var(--font-head); color: var(--ink-2); font-size: 14px; white-space: nowrap; }
  .article :global(td:first-child) { white-space: nowrap; }
  .article :global(ol), .article :global(ul) { margin: 0; padding-left: 1.3em; display: flex; flex-direction: column; gap: var(--sp-2); }
  .article :global(.cta) { background: var(--brand-soft); border-radius: var(--r-lg); padding: var(--sp-4); display: flex; flex-direction: column; gap: var(--sp-3); }
  .article :global(.sw) { display: inline-block; width: 12px; height: 12px; margin-right: 6px; border: 1px solid var(--map-edge); border-radius: 3px; vertical-align: -1px; }
  .article :global(table.nums th:not(:first-child)), .article :global(table.nums td:not(:first-child)) { text-align: right; }
  .article :global(.src) { font-size: 15px; line-height: 23px; color: var(--ink-2); }
</style>
