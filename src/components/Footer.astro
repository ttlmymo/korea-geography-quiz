---
// 공통 바닥글: 소개·문의·방침·데이터 출처·언어 링크와 문의 메일.
// 2026-11-18 사용자 결정: 바닥글에 늘어놓던 출처 줄(행정동 경계·데이터 판·이웃 땅)을 지우고 데이터 출처 쪽(/sources/)에만 둔다 — 그 쪽에 같은 내용이 모두 있다.
// 출처 표기(통계청 SGIS 공공누리 제1유형 · vuski/admdongkor CC BY 4.0)는 /sources/ 와 지도 화면의 출처 줄(app/text/ui.ts source)이 맡는다.
// 영어 쪽에는 출처 쪽이 없어 한국어 출처 쪽으로 가는 링크를 둔다(지우면 영어 정적 쪽에서 출처로 가는 길이 없어진다)
import { href } from '../lib/paths';
import { SITE_NAME, SITE_NAME_EN, CONTACT_EMAIL } from '../consts';

interface Props { lang?: 'ko' | 'en' }
const { lang = 'ko' } = Astro.props;
const en = lang === 'en';
// 다른 언어 링크에는 lang·hreflang 을 단다(그 말의 읽기 음성으로 읽히게). 글은 이 쪽 말이고 가는 곳만 다른 말이면 hreflang 만(to)
const links = en
  ? [{ t: 'Privacy policy', h: href('/privacy-en.html') }, { t: 'Data sources (Korean)', h: href('/sources/'), to: 'ko' }, { t: '한국어', h: href('/'), lang: 'ko' }]
  : [
      { t: '소개', h: href('/about/') },
      { t: '문의', h: href('/contact/') },
      { t: '개인정보처리방침', h: href('/privacy.html') },
      { t: '데이터 출처', h: href('/sources/') },
      { t: 'English', h: href('/en/'), lang: 'en' },
    ];
---
<footer class="foot">
  <div class="wrap foot-in">
    <ul class="links">{links.map((l) => <li><a href={l.h} lang={'lang' in l ? l.lang : undefined} hreflang={'lang' in l ? l.lang : 'to' in l ? l.to : undefined}>{l.t}</a></li>)}</ul>
    <p>{en ? 'Contact' : '문의'}: <span class="mail">{CONTACT_EMAIL}</span> · © {en ? SITE_NAME_EN : SITE_NAME}</p>
  </div>
</footer>

<style>
  .foot { border-top: 1px solid var(--line); margin-top: var(--sp-8); }
  .foot-in {
    padding-block: var(--sp-2) calc(var(--sp-6) + env(safe-area-inset-bottom, 0px));
    display: flex; flex-direction: column; gap: var(--sp-1);
    font-size: var(--fs-14); line-height: 1.6; color: var(--ink-3);
  }
  .links { list-style: none; margin: 0 0 var(--sp-1); padding: 0; display: flex; flex-wrap: wrap; gap: 0 var(--sp-6); }
  .links a { display: inline-flex; align-items: center; min-height: var(--tap-min); color: var(--ink-2); text-decoration: none; }
  .links a:hover { text-decoration: underline; }
  .foot p a { color: var(--ink-2); }
  .mail { user-select: all; }
  @media (min-width: 1024px) { .links { gap: 0 28px; } }
</style>
