---
// 로고: 세 폭으로 접힌 지도, 가운데 폭이 칠해져 있다(채움)
interface Props { size?: number }
const { size = 26 } = Astro.props;
---
<svg width={size} height={Math.round(size * 24 / 26)} viewBox="0 0 26 24" aria-hidden="true" class="logo-mark">
  <path d="M1 4l7-3v19l-7 3z" fill="var(--surface)" stroke="var(--ink)" stroke-width="1.5" stroke-linejoin="round" />
  <path d="M8 1l9 3v19l-9-3z" fill="var(--m3)" stroke="var(--ink)" stroke-width="1.5" stroke-linejoin="round" />
  <path d="M17 4l8-3v19l-8 3z" fill="var(--m1)" stroke="var(--ink)" stroke-width="1.5" stroke-linejoin="round" />
</svg>
